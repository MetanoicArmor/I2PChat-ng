<?xml version="1.0" encoding="utf-8"?>
<!-- Only received media is ever shared out. Profile keys, history and router
     state live next to these directories and must stay unreachable through
     the provider. -->
<paths>
    <files-path name="profiles" path="i2pchat/profiles/" />
    <!-- Plaintext of a sealed download, only while the user is opening it. -->
    <cache-path name="incoming_view" path="incoming/view/" />
</paths>
