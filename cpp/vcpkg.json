{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "i2pchat-cpp",
  "description": "I2PChat C++ client: peer-to-peer chat over the I2P network",
  "homepage": "https://github.com/MetanoicArmor/I2PChat",
  "license": "AGPL-3.0-or-later",
  "builtin-baseline": "a4c8cc7eef578f43d36aca111b523180960c0c2e",
  "dependencies": [
    "libsodium",
    "nlohmann-json",
    "zlib",
    "boost-asio",
    "boost-process",
    "boost-system"
  ],
  "features": {
    "tests": {
      "description": "Build the C++ test suite",
      "dependencies": ["catch2"]
    },
    "tui": {
      "description": "Build the FTXUI terminal client",
      "dependencies": ["ftxui"]
    },
    "gui": {
      "description": "Build the Qt 6 desktop client (Widgets + Network only)",
      "dependencies": [
        {
          "name": "qtbase",
          "default-features": false,
          "features": ["gui", "widgets", "network", "png", "openssl", "thread", "concurrent"]
        }
      ]
    }
  }
}
